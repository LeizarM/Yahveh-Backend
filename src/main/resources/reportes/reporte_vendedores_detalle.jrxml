              name="reporte_vendedores_detalle"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="812" leftMargin="15" rightMargin="15" topMargin="8" bottomMargin="8"
              uuid="a2000000-0000-0002-0000-000000000001">

  <parameter name="fechaDesde" class="java.util.Date"/>
  <parameter name="fechaHasta" class="java.util.Date"/>

  <field name="nombreVendedor" class="java.lang.String"/>
  <field name="fecha" class="java.time.LocalDate"/>
  <field name="codNotaEntrega" class="java.lang.Long"/>
  <field name="nombreCliente" class="java.lang.String"/>
