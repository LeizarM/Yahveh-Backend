  </variable>
  <variable name="sumTotalGrupo" class="java.lang.Float" resetType="Group" resetGroup="vendedor" calculation="Sum">
    <variableExpression><![CDATA[$F{totalBs}]]></variableExpression>
  </variable>
  <variable name="countTotalGeneral" class="java.lang.Integer" calculation="Count">
    <variableExpression><![CDATA[$F{codNotaEntrega}]]></variableExpression>
  </variable>
  <variable name="sumTotalGeneral" class="java.lang.Float" calculation="Sum">
    <variableExpression><![CDATA[$F{totalBs}]]></variableExpression>
  </variable>

