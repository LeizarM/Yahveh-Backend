  <field name="cantidadArticulos" class="java.lang.Integer"/>
  <field name="totalBs" class="java.lang.Float"/>

  <variable name="countNotasGrupo" class="java.lang.Integer" resetType="Group" resetGroup="vendedor" calculation="Count">
